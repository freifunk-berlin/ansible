---
# 16G
proxmox_zfs_arc_size: 68719476736

# Add hugepages 16 for cr1 one for l105-gw
# Disable lower cstates to improve latency
proxmox_kernel_cmdline: "root=ZFS=rpool/ROOT/pve-1 boot=zfs default_hugepagesz=1G hugepagesz=1G hugepages=0:18 intel_iommu=on iommu=pt transparent_hugepage=never intel_idle.max_cstate=2
"
