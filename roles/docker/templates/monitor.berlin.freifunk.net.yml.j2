---
services:
  collectd-prometheus-exporter:
    restart: unless-stopped
    image: prom/collectd-exporter:latest
    ports:
      - 9104:9103
      - 127.0.0.1:25827:25826/udp
    command: --collectd.listen-address=":25826"

  pushgateway:
    restart: unless-stopped
    image: prom/pushgateway:v1.11.4
    resources:
      limits:
        memory: 4G
    ports:
      - 127.0.0.1:9091:9091

  blackbox:
    restart: unless-stopped
    image: prom/blackbox-exporter:v0.29.1
    # network: host to allow V6 ping
    network_mode: host
    command:
      - '--config.file=/etc/blackbox/blackbox.yml'
    volumes:
      - /etc/freifunk/blackbox.yml:/etc/blackbox/blackbox.yml

  snmp-exporter:
    image: prom/snmp-exporter:v0.30.1
    restart: unless-stopped
    volumes:
      - /etc/freifunk/snmp.yml:/etc/snmp_exporter/snmp.yml
    ports:
      - "9116:9116"

  victoriametrics:
    restart: unless-stopped
    image: victoriametrics/victoria-metrics:v1.154.1
    ports:
      - 8428:8428
      - 9090:8428
      - 8089:8089
      - 8089:8089/udp
      - 4242:4242
    command:
      - '--retentionPeriod=365'
      - '--storageDataPath=/victoria-metrics-data'
      - '--httpListenAddr=:8428'
      - '--influxListenAddr=:8089'
    volumes:
      - /mnt/victoriametrics/data:/victoria-metrics-data

  vmagent:
    image: victoriametrics/vmagent:v1.154.1
    depends_on:
      - "victoriametrics"
    ports:
      - 8429:8429
    volumes:
      - type: bind
        source: /mnt/vmagentdata/data/
        target: /vmagentdata
      - type: bind
        source: /mnt/vmagentdata/prometheus.yml
        target: /etc/prometheus/prometheus.yml
    command:
      - "--promscrape.config=/etc/prometheus/prometheus.yml"
      - "--remoteWrite.url=http://victoriametrics:8428/api/v1/write"
      - "-opentelemetry.usePrometheusNaming"
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"


