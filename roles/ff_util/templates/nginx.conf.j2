user www-data;
worker_processes auto;
worker_cpu_affinity auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
    # multi_accept on;
}

http {
    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    proxy_cache_path /opt/tilecache levels=1:2 keys_zone=osm:100m max_size=5g inactive=180d;

    access_log off;
    error_log /var/log/nginx/error.log info;

    server {
        listen localhost:8080 default_server;

        root /var/www/html;

        index index.html index.htm index.nginx-debian.html;

        server_name _;

        proxy_cache osm;
        proxy_cache_valid 180d;
        proxy_redirect off;
        proxy_set_header User-Agent "FFBerlin Tile Cache";
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Via "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";

        location / {
            return 418;
        }

        location /osm_de {
            proxy_pass https://tile.openstreetmap.de/;
            proxy_set_header Host tile.openstreetmap.de;
            proxy_ssl_server_name on;
            proxy_ssl_name tile.openstreetmap.de;
        }
        location /versatiles/ {
            proxy_pass https://tiles.versatiles.org/;
            proxy_set_header Host tiles.versatiles.org;
            proxy_ssl_server_name on;
            proxy_ssl_name tiles.versatiles.org;
            proxy_set_header User-Agent "FFBerlin Tile Cache";
            proxy_set_header Cookie "";
            proxy_set_header Referer "";
            proxy_set_header Via "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header Accept-Encoding "";
        }

    }
}
